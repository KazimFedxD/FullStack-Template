# Application Settings
APP_NAME=YourAppName
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL (without trailing slash)
BASE_URL=http://localhost

# Database Configuration
DATABASE_URL=postgres://template_user:template_password@db:5432/template_db

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL=your-email@example.com
EMAIL_PASS=your-email-password-or-app-password

# Redis & Cache Configuration
REDIS_URL=redis://redis:6379/1
CACHE_PREFIX=myapp

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0

# API Key (Optional - for APIKeyPermission)
API_KEY=your-api-key-here

# Encryption Key (auto-generated if not provided)
# ENCRYPTION_KEY=your-fernet-key-here

# CORS Settings
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Security Settings (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

